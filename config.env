CONFIG_ENV=config.env
# ===== 内核源：LineageOS 官方一加 8 Pro 内核 =====
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
# ===== 分支：必须与我们刷入的 LineageOS 23.2 对应 =====
KERNEL_SOURCE_BRANCH=lineage-23.2
# ===== defconfig：一加 8 Pro (kona 平台) perf 配置 =====
KERNEL_CONFIG=vendor/kona-perf_defconfig

# 4.19 老内核使用 Google GCC 4.9 + aosp-clang-r383902b 构建
USE_GCC=true

# 关闭 LXC/Docker 支持（不需要，开启会增加编译失败风险）
ENABLE_LXC=false

# ===== KernelSU（默认开启）=====
ENABLE_KERNELSU=true
ADD_OVERLAYFS_CONFIG=true

# 非 GKI 内核（4.19）用官方最后支持版本 v0.9.5
KERNELSU_TAG=v0.9.5

KERNEL_IMAGE_NAME=Image
ARCH=arm64

EXTRA_CMDS:LD=ld.lld
EXTRA_CMDS:LLVM=1 LLVM_IAS=1

# 加速二次构建
ENABLE_CCACHE=true

# 关闭 fstack-protector-strong (clang-r383902b)
DISABLE_FST=true

# Kali-Nethunter / WireGuard
ENABLE_NETHUNTER=false
ENABLE_KALI=false
KERNEL_VERSION=4.19
ENABLE_WIREGUARD=true

### 以下保持默认 ###
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
DISABLE-LTO=true
DISABLE_CC_WERROR=true
NEED_DTBO=false

# 直接产出可 fastboot 刷入的 boot.img
# 源 boot.img 用 LineageOS 官方对应版本（保证 ramdisk 与系统匹配）
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://mirrorbits.lineageos.org/full/instantnoodlep/20260925/boot.img
